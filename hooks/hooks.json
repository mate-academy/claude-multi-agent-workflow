{
  "description": "Run ESLint after file edits to help maintain API quality.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm --prefix \"${CLAUDE_PLUGIN_ROOT}/course-api\" run lint",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
