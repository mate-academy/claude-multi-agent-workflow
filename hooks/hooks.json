{
  "description": "Lint a JS file right after Claude writes or edits it",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.js)",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-changed.sh"],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Edit(*.js)",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-changed.sh"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
