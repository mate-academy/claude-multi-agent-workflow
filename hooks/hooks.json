{
  "description": "Lint JavaScript files with the project's ESLint right after Claude writes or edits them.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/lint-on-save.js\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
