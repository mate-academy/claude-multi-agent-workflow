{
  "description": "After Claude writes or edits a .js file, syntax-check it with node --check and feed errors back.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-js.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
